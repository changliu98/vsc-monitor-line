{
  "name": "resource-monitor-statusbar",
  "displayName": "Resource Monitor Statusbar",
  "description": "htop like status bar: CPU usage & frequency, memory, swap, GPU & VRAM, temperature, fan speed",
  "version": "1.1.0",
  "publisher": "changliu98",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": ["Other"],
  "repository": {
    "type": "git",
    "url": "https://github.com/changliu98/vsc-monitor-line"
  },
  "icon": "icon.png",
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "systemMonitor.openPanel",
        "title": "System Monitor: Open Panel"
      }
    ],
    "configuration": {
      "title": "System Monitor",
      "properties": {
        "systemMonitor.items": {
          "type": "array",
          "default": ["cpu", "freq", "mem", "swp", "run"],
          "items": {
            "type": "string",
            "enum": ["cpu", "freq", "mem", "swp", "run", "temp", "fan", "gpu", "vram"]
          },
          "uniqueItems": true,
          "description": "Status bar items to display and their order. Remove an entry to hide it, reorder to rearrange. 'temp'/'fan' are Linux-only. 'gpu'/'vram' require NVIDIA or AMD."
        },
        "systemMonitor.updateInterval": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 60,
          "description": "Status bar update interval in seconds."
        },
        "systemMonitor.icons": {
          "type": "object",
          "default": {
            "cpu":  "chip",
            "freq": "pulse",
            "mem":  "server",
            "swp":  "archive",
            "run":  "run",
            "temp": "thermometer",
            "fan":  "dashboard",
            "gpu":  "graph-line",
            "vram": "database"
          },
          "properties": {
            "cpu":  { "type": "string", "default": "chip" },
            "freq": { "type": "string", "default": "pulse" },
            "mem":  { "type": "string", "default": "server" },
            "swp":  { "type": "string", "default": "archive" },
            "run":  { "type": "string", "default": "run" },
            "temp": { "type": "string", "default": "thermometer" },
            "fan":  { "type": "string", "default": "dashboard" },
            "gpu":  { "type": "string", "default": "graph-line" },
            "vram": { "type": "string", "default": "database" }
          },
          "additionalProperties": false,
          "description": "Codicon name for each status bar item. Use any name from https://microsoft.github.io/vscode-codicons/dist/codicon.html (without the '$()' wrapper). Set to empty string to show no icon."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.75.0",
    "typescript": "^5.0.0"
  }
}
